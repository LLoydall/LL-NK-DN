# Shared configuration for the whole project.
# Read by: the API server (server/.env can override individual values) and docker compose.

# --- GCP / Vertex AI (Qwen via Model Garden) ---
GCP_PROJECT_ID=priv-mkt-hack26lon-3752
VERTEX_LOCATION=europe-west2
# First-party Gemini publisher model — works with ADC, no deployment needed.
VERTEX_CHAT_MODEL=gemini-2.5-flash
# To use a deployed Model Garden model (e.g. Qwen) instead, set
# VERTEX_CHAT_MODEL to its served model id and set the endpoint id here.
# VERTEX_CHAT_ENDPOINT_ID=
VERTEX_EMBEDDING_MODEL=text-embedding-004
# Auth is via Application Default Credentials (gcloud auth application-default login,
# or Workload Identity on GKE). No key env var needed.

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ylookup-rules

# --- Deterministic engine (Python FastAPI) ---
ENGINE_URL=http://localhost:8081

# --- Server ---
PORT=8080

# --- Retrieval tuning ---
TOP_K=8
SCORE_THRESHOLD=0.25
MAX_CONTEXT_CHARS=12000
MAX_HISTORY_MESSAGES=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Embedding pacing (lab projects have tiny per-minute quotas on embeddings)
EMBED_BATCH_SIZE=250
EMBED_BATCH_DELAY_MS=1000
EMBED_MAX_RETRIES=5
